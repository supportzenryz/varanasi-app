# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database and staging artefacts
/data/*.db
/data/*.db-*

# Nightly backups and the local email outbox.
#
# `/data/*.db` above does NOT cover `/data/backups/varanasi-….db` — a leading
# slash pattern matches one level only — so thirty database copies were on
# their way into the repository, and beside them an outbox of every message the
# app has ever composed: guest names, addresses, phone numbers, dietary notes,
# voucher codes and password-reset links, in plain text, 895 files of it.
#
# This repository is the thing the restaurant is buying. Committing real guest
# data to it puts personal data somewhere it cannot be erased on request — the
# opposite of what the erasure screen exists to do, and permanent, because git
# keeps what you delete.
/data/backups/
/data/outbox/

# Zenryz commercial papers — day rates, margin, what to say on the call.
# The client owns this repository. This one is not theirs to read.
/docs/zenryz-*
shot.mjs
# captured media is imported locally, not committed
/public/media/**
!/public/media/**/themes/yootheme/fonts/**
shot*.mjs

# scratch tree written by npm run test:money
.tmp-money-test/
.tmp-auth-test/
.tmp-qr-test/
.tmp-marketing-test/
