# Copy to .env.local and fill in. Nothing here is required to run the site —
# without these the booking flow still works end to end, using a clearly
# labelled payment simulator and writing emails to data/outbox instead of
# sending them. That's deliberate, so the whole journey can be demonstrated
# before any accounts exist.

# ---------------------------------------------------------------------------
# The site's own address. Used to build the payment return links and the
# "manage your booking" link in confirmation emails, so it must be the address
# guests actually reach the site on.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Session signing. Generate a long random value before going live:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Stripe — takes the table deposits.
#
# Start in TEST mode (keys begin sk_test_). Card details never touch this
# site: guests pay on Stripe's own hosted page.
#
#   1. STRIPE_SECRET_KEY: Stripe dashboard -> Developers -> API keys
#   2. STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add an endpoint at
#      https://<your domain>/api/stripe/webhook subscribed to:
#          checkout.session.completed
#          checkout.session.async_payment_succeeded
#          checkout.session.async_payment_failed
#          checkout.session.expired
#      then copy its signing secret (whsec_...).
#
#      For local testing instead:  stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# The webhook is what guarantees a paid booking gets confirmed even if the
# guest closes the tab, so it must be set before taking real money.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email — the guest's confirmation and the restaurant's alert.
#
# Option A (recommended): Resend. Sign up, verify the varanasi.uk domain,
# create an API key. MAIL_FROM must be on a verified domain.
#
# Option B: any automation tool that accepts a JSON webhook (Zapier, Make,
# n8n). Set MAIL_WEBHOOK_URL instead and it receives {from,to,subject,text}.
#
# With neither set, every email is written to data/outbox as a readable .txt
# file — useful for testing, useless to guests, so set one before launch.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=reservations@varanasi.uk
# MAIL_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Database. SQLite is fine for launch; move to Postgres when there is real
# traffic or more than one instance.
#
# On a host with a mounted disk, point this at the mount, not at the image:
# anything written inside the container is lost on the next deploy. A `file:`
# prefix is accepted and stripped, since several hosts hand it over that way.
#   Railway / Render with a volume at /data:   DATABASE_URL=/data/varanasi.db
# ---------------------------------------------------------------------------
DATABASE_URL=./data/varanasi.db

# ---------------------------------------------------------------------------
# Photography (Cloudinary). Optional.
#
# The media library is around a quarter of a gigabyte. Committing it works, but
# GitHub warns above 50MB a file, every deploy carries the whole thing, and the
# app container ends up resizing photographs it could have been served.
# Uploading the library to Cloudinary instead and setting the cloud name below
# moves all of that off the box. Leave it blank and every image is served from
# public/ exactly as before — the site does not depend on this.
#
# FOLDER is the path the uploads landed under inside Cloudinary. Dragging the
# branch folders into the media library puts them at the root, which is the
# default of "" here. If the full original path was preserved, set it to
# media/lib. Getting it wrong shows up as broken images and is fixed by
# changing this one value and redeploying — the database is untouched either
# way, because it stores /media/lib/... paths and the CDN is applied at render.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FOLDER=

# ---------------------------------------------------------------------------
# WhatsApp — booking confirmations and the after-dining message.
#
# IMPORTANT: WhatsApp does not allow free-form messages to someone who hasn't
# written to you in the last 24 hours. Outside that window only TEMPLATES that
# Meta has approved in advance can be delivered. Booking confirmations and the
# thank-you both fall outside it, so both need approved templates before they
# will send. That needs: a Meta Business account, a verified business, a
# WhatsApp Business number, and one approval per template (allow a few days).
#
# The exact wording to submit is in src/lib/whatsapp.ts (TEMPLATE_BODIES), and
# the template names the code uses are in data/booking.json under
# whatsapp.templates. Until credentials are set, every message is written to
# data/outbox so the wording can be reviewed and approved first.
#
# Option A — Meta WhatsApp Cloud API (direct, no middleman fee):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
#
# Option B — Twilio (simpler onboarding, per-message fee on top):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# ---------------------------------------------------------------------------
# Analytics. Set the GA4 measurement ID in the admin under Settings, or here.
# Nothing loads until a visitor accepts cookies, and no banner is shown at all
# until an ID exists — so the site doesn't nag about cookies it isn't setting.
# There is currently NO analytics on the live site, so there's no historical
# baseline; install this at launch to start one.
# ---------------------------------------------------------------------------
# (configured in Admin -> Settings, stored in the database)

# ---------------------------------------------------------------------------
# Google review links for the after-dining message. Set these in the admin
# under Settings — get each from the branch's Google Business Profile,
# "Ask for reviews" -> short link. Without them the thank-you still sends,
# just without a review request.
# ---------------------------------------------------------------------------
