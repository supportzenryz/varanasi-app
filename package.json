{
  "name": "varanasi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/ensure-db.mjs && next start",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:generate": "drizzle-kit generate",
    "media:import": "node scripts/import-media.mjs",
    "exact:build": "node scripts/build-exact.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "db:ensure": "node scripts/ensure-db.mjs",
    "test:stripe": "npx --yes tsx tests/stripe.mts",
    "test:validate": "npx --yes tsx tests/validate.mts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
